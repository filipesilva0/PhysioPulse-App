# Copy to .env on the ZimaOS server and fill in every value.
POSTGRES_PASSWORD=                      # `openssl rand -base64 32`
DATA_DIR=/DATA/AppData/physiopulse          # plain disk for now (owner, 7 Nov 2026; confirmed 11 Nov for phase 3)
BACKUP_DIR=/DATA/Backups/physiopulse        # ideally a different disk from DATA_DIR
AGE_RECIPIENT=age1...                   # PUBLIC key from `age-keygen` (keep the private key off the server)
RCLONE_REMOTE=                          # optional off-site copy, e.g. b2:physiopulse-backups
IDLE_MINUTES=15
SERVER_PORT=8080                        # port on this server; change if 8080 is taken (e.g. by Nginx Proxy Manager). Never forward it on the router.
BIND_IP=0.0.0.0                         # which of this server's addresses publishes SERVER_PORT (Nginx Proxy Manager must reach it)
PUBLIC_URL=                             # the staff API's HTTPS address via Nginx Proxy Manager: https://physiopulse-clinica.duckdns.org (later e.g. https://clinica.physiopulse.pt)
SECRET_KEY=                             # `openssl rand -hex 32` — encrypts the two-step secrets; keep a copy with the backup key
TRUSTED_PROXIES=                        # optional; default 127.0.0.1/32,::1/128,172.16.0.0/12 (Docker, where NPM runs)
OLLAMA_URL=                             # default only: the owner can change it in the app (Settings › Local AI). Empty = the ollama container; or e.g. http://192.168.1.66:11434 (the AI PC on the home network)
OLLAMA_MODEL=gemma3:12b                 # local AI for discharge-letter drafts (pull it once; gemma3:4b if the server is slow)
WHISPER_URL=                            # speech-to-text for session recordings: whisper-server on the AI PC, e.g. http://192.168.1.66:8178 (the owner can set it in the app)
PORTAL_DB_PASSWORD=                     # phase 4a: the website's database login — 32 letters/digits (`head -c 48 /dev/urandom | base64 | tr -dc A-Za-z0-9 | head -c 32`)
FORM_KEY=                               # phase 4a: signs the website's request form (`openssl rand -hex 32`)
SITE_PORT=8096                          # phase 4a: the website's port on this server (Nginx Proxy Manager forwards physiopulse.duckdns.org here). Never forward it on the router.
SITE_URL=                               # phase 4a: the website's public address, e.g. https://physiopulse.duckdns.org (later https://physiopulse.pt)

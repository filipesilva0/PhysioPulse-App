{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PhysioPulse",
  "version": "0.15.0",
  "identifier": "app.physiopulse",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "PhysioPulse",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 640,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 23 },
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --lang=pt-PT --accept-lang=pt-PT,en-GB"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; frame-src blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "msi", "nsis"],
    "category": "Medical",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "11.0", "entitlements": "Entitlements.plist" }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlFMUUyODlCN0Y5MTI2RTcKUldUbkpwRi9teWdlbm9JYnlMbDduOEp3cEthUlpJNEdyN2dsMWtINHVJMWdYcGl3OFZvbHdnSVoK",
      "endpoints": ["https://github.com/filipesilva0/PhysioPulse-App/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  }
}
